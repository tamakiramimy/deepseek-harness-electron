{
  "name": "deepseek-harness-electron",
  "version": "0.1.0",
  "description": "A secure cross-platform desktop workbench for DeepSeek Harness.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "package": "pnpm build && electron-builder --config electron-builder.yml",
    "package:mac": "pnpm build && electron-builder --mac --config electron-builder.yml",
    "package:win": "pnpm build && electron-builder --win --config electron-builder.yml",
    "package:linux": "pnpm build && electron-builder --linux --config electron-builder.yml"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
